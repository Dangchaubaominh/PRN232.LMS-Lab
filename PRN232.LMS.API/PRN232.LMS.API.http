# docker compose: 8080; dotnet run (launchSettings.json): 5075
@host = http://localhost:8080
# Filled from the login response below (Visual Studio 17.12+, VS Code REST Client).
@token = {{login.response.body.$.data.accessToken}}
@refreshToken = {{login.response.body.$.data.refreshToken}}

### Log in first: every /api/v1 and /api/v2 endpoint needs the access token
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "123456" }

### Who am I
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Without a token -> 401
GET {{host}}/api/students

### Refresh: returns a new pair; the refresh token used here stops working
POST {{host}}/api/auth/refresh-token
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

###
GET {{host}}/api/students?search=student&sort=fullName,-dateOfBirth&page=1&size=5&fields=studentId,fullName,email
Accept: application/json
Authorization: Bearer {{token}}

###
GET {{host}}/api/enrollments?search=active&sort=-enrollDate&page=1&size=20&expand=student,course
Accept: application/json
Authorization: Bearer {{token}}

###
GET {{host}}/api/students/1
Accept: application/json
Authorization: Bearer {{token}}

### Content negotiation: XML
GET {{host}}/api/students?size=2&fields=studentId,fullName
Accept: application/xml
Authorization: Bearer {{token}}

### Content negotiation: unsupported format -> 406
GET {{host}}/api/students
Accept: text/csv
Authorization: Bearer {{token}}

### Validation: custom FPTU student code rule, [StringLength], [Phone]
POST {{host}}/api/students
Content-Type: application/json
Authorization: Bearer {{token}}

{ "studentCode": "AB12345", "fullName": "A", "email": "a@lms.edu.vn", "phone": "call me", "dateOfBirth": "2003-01-01" }

### Validation: FluentValidation (EndDate must be after StartDate)
POST {{host}}/api/semesters
Content-Type: application/json
Authorization: Bearer {{token}}

{ "semesterName": "Fall 2026", "startDate": "2026-09-01", "endDate": "2026-08-01" }

### Create a student; X-Request-Id is bound with [FromHeader] and written to the audit log
POST {{host}}/api/students
Content-Type: application/json
Authorization: Bearer {{token}}
X-Request-Id: demo-create-1

{ "studentCode": "SE193293", "fullName": "Dang Chau Bao Minh", "email": "minhdcb@lms.edu.vn", "phone": "0901234567", "dateOfBirth": "2003-01-01" }

### Request id is echoed in the X-Request-Id response header and in the request log
GET {{host}}/api/students/99999
Accept: application/json
Authorization: Bearer {{token}}
X-Request-Id: demo-123

### Versioning: the same student in v1 and v2
GET {{host}}/api/v1/students/1
Accept: application/json
Authorization: Bearer {{token}}

###
GET {{host}}/api/v2/students/1
Accept: application/json
Authorization: Bearer {{token}}

### v2 list with enrollmentCount
GET {{host}}/api/v2/students?size=5&sort=-studentCode&fields=studentCode,fullName,dateOfBirth,enrollmentCount
Accept: application/json
Authorization: Bearer {{token}}

### Nested resource: active students of course 1
GET {{host}}/api/v1/courses/1/students?status=Active&fields=studentId,studentCode,fullName
Accept: application/json
Authorization: Bearer {{token}}

### Admin only: DELETE (log in as student / 123456 to see 403)
DELETE {{host}}/api/v1/semesters/1
Authorization: Bearer {{token}}
