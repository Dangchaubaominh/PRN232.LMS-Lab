@host = http://localhost:5075

GET {{host}}/api/students?search=student&sort=fullName,-dateOfBirth&page=1&size=5&fields=studentId,fullName,email
Accept: application/json

###
GET {{host}}/api/enrollments?search=active&sort=-enrollDate&page=1&size=20&expand=student,course
Accept: application/json

###
GET {{host}}/api/students/1
Accept: application/json
