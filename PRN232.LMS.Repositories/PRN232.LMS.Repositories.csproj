<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <!-- Private: projects that reference Repositories (Services) cannot use EF Core, so data access stays here.
         The API, which configures the DbContext, references EF Core itself. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.19" PrivateAssets="all" />
  </ItemGroup>
</Project>
